{
  "name": "idrok-adaptiv-demo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/check-files.mjs && tsc --noEmit && vite build",
    "start": "node --experimental-strip-types --env-file-if-exists=.env server.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --experimental-strip-types tests/demo-session.test.mjs && node --experimental-strip-types tests/server.test.mjs && node --experimental-strip-types tests/function-engine.test.mjs && node --experimental-strip-types tests/ai-service.test.mjs",
    "dev": "node --experimental-strip-types scripts/dev.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
